# Copy to .env. Never commit .env or reuse example values as secrets.
DEBUG=0
DJANGO_SECRET_KEY=
SITE_DOMAIN=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=photo_association
POSTGRES_USER=photo_association
POSTGRES_PASSWORD=
SITE_NAME=摄影协会
# Set an SMTP backend before enabling password recovery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
# Optional private S3-compatible bucket. Empty means Docker media volume.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
